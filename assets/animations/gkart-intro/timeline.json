 "easings": {
  "linear": "p",
  "easeOutCubic": "1-(1-p)^3",
  "easeInCubic": "p^3",
  "easeOutBack": "c3=c1+1; 1+c3*(p-1)^3+c1*(p-1)^2   (param c1, default 1.70158)",
  "bounceOut": "Penner: n1=7.5625,d1=2.75 piecewise",
  "springOut": "p>=1?1: 1-exp(-damping*p)*cos(2*pi*freq*p)   (use freq=n+0.25)",
  "easeSpeedIn": "1-(1-p^b)^a  (a=brake, b=launch); velocity a*b*p^(b-1)*(1-p^b)^(a-1) -> 0 at p=1"
 },
 "rules": {
  "zOrder": "layers[] is stored in DRAW order (z ascending, bottom->top = Design README). Ghosts are drawn directly beneath their own layer.",
  "progress": "p=clamp((t-start)/(land-start),0,1); value=from+(to-from)*ease_channel(p); hidden when t<start",
  "alpha": "alpha=from.alpha+(to.alpha-from.alpha)*clamp(p/alphaFrac,0,1)  (linear)",
  "bounces": "after land: tt=t-land; for each {h,dur}: if tt<dur {y-=h*4*(tt/dur)*(1-tt/dur); break} else tt-=dur   (h in logo px)",
  "sway": "after land: q=(t-land)/dur in [0,1): rotation+=amp*sin(2*pi*swings*q)*(1-q)",
  "overshoot": "after land: u=t-land; k=px*easeOutCubic(u/rise) for u<rise, px*(1-easeOutCubic((u-rise)/fall)) for rise<=u<rise+fall (then exactly 0); (x,y)+=k*(cos(dirDeg),-sin(dirDeg))",
  "stretch": "for each {pivotX,amount,group}: pg=clamp((t-g.start)/(g.land-g.start)); f=1+amount*vel(g.easing,pg)/velmax (velmax sampled at i/400); applied in order AFTER the layer transform as a scale ALONG the path axis u=(cos(angleDeg),-sin(angleDeg)) (screen, y down) about canvas pivot (pivotX,pivotY): q -> o+(q-o)+(f-1)((q-o).u)u; angleDeg=0 is the old x-stretch; f==1 at land",
  "ghost": "for i=1..count: tg=t-i*lag; draw only if start<tg<land; pose at tg; alpha=main_alpha*ghost.alpha*(1-(i-1)/count)",
  "shake": "q=(t-time)/dur in [0,1): a=px*(1-q)^2; without dirDeg: dx=0.7*a*cos(2*pi*fx*q+1.1); dy=a*cos(2*pi*fy*q). With dirDeg (v4, th): along=a*cos(2*pi*fx*q); perp=0.35*a*cos(2*pi*fy*q+1.1); dx=along*cos(th)+perp*sin(th); dy=-along*sin(th)+perp*cos(th); px in reference px (x canvasW/1920)",
  "transform": "point_canvas = canvasCenter + S*(Rot(rotation)*Scale(scale)*(p-pivot) + pivot + (x,y) - logoCenter) + shake + idle; S=stageScale*logoFit",
  "shine": "source-atop white gradient band; axis u=(sin(angle),cos(angle)); s(t)=lerp(smin-w/2, smax+w/2, linear(t)); alpha=interp(stops)"
 },
